{
  "manifest_version": 3,
  "name": "MoviePeek",
  "version": "1.4",
  "description": "Hover a movie or show name to see its rating, genre and plot.",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://v3.sg.media-imdb.com/*",
    "https://caching.graphql.imdb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MoviePeek",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "32": "images/toolbar-32.png",
      "64": "images/toolbar-64.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  }
}
